{
  "name": "bqaa-dashboard-mcp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP App: interactive BigQuery Agent Analytics dashboard rendered inside MCP hosts",
  "scripts": {
    "build": "INPUT=mcp-app.html vite build",
    "serve": "tsx server.ts",
    "start": "npm run build && npm run serve",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
